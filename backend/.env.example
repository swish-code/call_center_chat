# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:3000

# ── Database ─────────────────────────────────────────────
# Local docker-compose default. On Railway this is provided automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/callcenter
# Set to "require" when connecting to a managed DB that needs SSL (e.g. Railway)
DATABASE_SSL=false

# ── Auth ─────────────────────────────────────────────────
# CHANGE THIS to a long random string in production.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ── Gemini (Google AI) ───────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.0-flash
# Retrieval confidence gate. Below this cosine similarity the AI refuses
# and a gap ticket is opened. Tune with real bilingual questions (0.70–0.80).
SIMILARITY_THRESHOLD=0.75
# How many chunks to retrieve for context
RETRIEVAL_TOP_K=6

# ── Microsoft Graph (Outlook) — Phase 4 ──────────────────
# App registration in Entra ID with Mail.Read application permission.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox to poll (the AI inbox that gets CC'd)
GRAPH_MAILBOX=ai-inbox@yourcompany.com
# Shared secret to protect the internal /jobs/poll-outlook endpoint
JOBS_SECRET=dev-jobs-secret-change-me
